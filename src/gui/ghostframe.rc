#include <windows.h>

// Application Icon (Resource ID 1 ensures Windows Explorer uses this as the default EXE icon)
1 ICON "ghostframe.ico"

// Executable Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GhostFrame Project\0"
            VALUE "FileDescription",  "GhostFrame - Stream Capture Cloaker\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "ghostframe-gui\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 GhostFrame Project. All rights reserved.\0"
            VALUE "OriginalFilename", "ghostframe-gui.exe\0"
            VALUE "ProductName",      "GhostFrame\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
